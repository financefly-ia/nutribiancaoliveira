# Token do Vercel Blob. A Vercel cria automaticamente ao conectar um Blob Store ao projeto.
# Sem ele, em desenvolvimento, as inscrições ficam em .data/contatos/ (local).
BLOB_READ_WRITE_TOKEN=

# Senha de acesso ao painel (/painel) da Bianca.
ADMIN_PASSWORD=

# Segredo para assinar o cookie de sessão do painel (gere uma string aleatória longa).
SESSION_SECRET=

# URL pública do site (opcional). Ex.: https://nutribiancaoliveira.com.br
NEXT_PUBLIC_SITE_URL=
